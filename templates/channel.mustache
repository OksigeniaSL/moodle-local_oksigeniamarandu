                    <input type="hidden" name="part" value="links">
                    <input type="hidden" name="utm" value="{{#utm}}1{{/utm}}{{^utm}}0{{/utm}}">
                    <button type="submit" class="mrd-default" tabindex="-1" aria-hidden="true"></button>
                    <p class="mrd-explica">{{#str}} channel:links:desc, local_oksigeniamarandu {{/str}}</p>
                    <button type="submit" class="mrd-llave" name="utm" value="{{#utm}}0{{/utm}}{{^utm}}1{{/utm}}" aria-pressed="{{#utm}}true{{/utm}}{{^utm}}false{{/utm}}"><span class="mrd-llave-i" aria-hidden="true"></span>{{#str}} channel:links:utm, local_oksigeniamarandu {{/str}}</button>
                    {{#example}}<p class="mrd-billete"><span>{{#str}} channel:links:example, local_oksigeniamarandu {{/str}}</span><code>{{.}}</code></p>{{/example}}
                    <div class="mrd-dorso">
                        <div class="mrd-campos">
                            {{#utm}}
                            <label class="mrd-campo"><span>utm_source</span><input type="text" name="utmsource" value="{{utmsource}}" autocomplete="off"></label>
                            <label class="mrd-campo"><span>utm_medium</span><input type="text" name="utmmedium" value="{{utmmedium}}" autocomplete="off"></label>
                            {{/utm}}
                            <label class="mrd-campo"><span>{{#str}} channel:links:shortener, local_oksigeniamarandu {{/str}}</span>
                                <input type="url" name="shortener" value="{{shortener}}" placeholder="https://" autocomplete="off"></label>
                            <label class="mrd-campo"><span>{{#str}} channel:links:signature, local_oksigeniamarandu {{/str}}</span>
                                <input type="password" name="shortenersignature" value="" autocomplete="new-password"{{#hassignature}} placeholder="{{#str}} channel:links:signatureset, local_oksigeniamarandu {{/str}}"{{/hassignature}}></label>
                        </div>
                        <button type="submit" class="mrd-btn mrd-primary mrd-guardar">{{#str}} save {{/str}}</button>
                    </div>
                </form>
            </details>
