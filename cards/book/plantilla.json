      "balance": false,
      "enter": {
        "effect": "fade",
        "start": 0.15,
        "duration": 0.5,
        "easing": "out-cubic",
        "drawtext": {
          "alpha": "clip((t-0.15)/0.50,0,1)*clip(({D}-t)/0.50,0,1)",
