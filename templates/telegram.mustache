{{!
    @template local_oksigeniamarandu/telegram

    Telegram: connect the bot of the site with its token, and test it from the phone of whoever sets it up. The steps
    to make the bot as a numbered list, the note on privacy before connecting, and the steps that come after.

    Context variables required for this template:
    * editing - Whether the token is asked for.
    * action, sesskey - The forms.
    * error - What went wrong, if anything.
    * privacy - A sentence on where Telegram keeps the messages.
    * track - The steps (label, done, now).
    * bot, botname, editurl, joinurl, qr, joined, sent - The bot connected, and its test.

    Example context (json):
    {
        "editing": true, "action": "#", "sesskey": "abc", "error": "", "privacy": "Telegram keeps these messages.",
        "track": [{"label": "Connect the bot", "done": false, "now": true}],
        "bot": "", "botname": "", "editurl": "#", "joinurl": "#", "qr": "", "joined": false, "sent": ""
    }
}}
<div class="local-oksigeniamarandu-wizard local-oksigeniamarandu-telegram">
    {{#editing}}
    <p class="mrd-lead">{{#str}} telegram:lead, local_oksigeniamarandu {{/str}}</p>
    <ol class="mrd-steps">
        <li>
            <span>{{#str}} telegram:step1, local_oksigeniamarandu {{/str}}</span>
            <a class="btn mrd-btn mrd-second mrd-small" href="https://t.me/BotFather" target="_blank" rel="noopener">{{#str}} telegram:openbotfather, local_oksigeniamarandu {{/str}}</a>
        </li>
        <li>
            <span>{{#str}} telegram:step2, local_oksigeniamarandu {{/str}}</span>
            <span class="mrd-copy"><code>/newbot</code><button type="button" class="btn mrd-btn mrd-second mrd-small" data-copy="/newbot" data-copied="{{#str}} wizard:copied, local_oksigeniamarandu {{/str}}">{{#str}} wizard:copy, local_oksigeniamarandu {{/str}}</button></span>
        </li>
        <li><span>{{#str}} telegram:step3, local_oksigeniamarandu {{/str}}</span></li>
    </ol>
    <form method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="connect">
        <div class="mrd-field mrd-blue">
            <label for="mrd-tgtoken">{{#str}} telegram:token, local_oksigeniamarandu {{/str}}</label>
            <span class="mrd-help">{{#str}} telegram:token_help, local_oksigeniamarandu {{/str}}</span>
            <input type="text" id="mrd-tgtoken" name="token" autocomplete="off" spellcheck="false"{{#error}} class="bad"{{/error}}>
            <span class="mrd-tokencheck" data-tokencheck aria-live="polite" data-ok="{{#str}} telegram:token:ok, local_oksigeniamarandu {{/str}}" data-bad="{{#str}} telegram:token:bad, local_oksigeniamarandu {{/str}}"></span>
            {{#error}}<span class="mrd-err">{{error}}</span>{{/error}}
        </div>
        <p class="mrd-note"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11 V17 M12 7.5 V7.6"/></svg><span>{{privacy}}</span></p>
        <div class="mrd-actions">
            <button type="submit" class="btn mrd-btn mrd-primary">{{#str}} telegram:connect, local_oksigeniamarandu {{/str}}</button>
        </div>
    </form>
    {{/editing}}
    {{^editing}}
    <p class="mrd-ok">✓ {{#str}} telegram:connected, local_oksigeniamarandu {{/str}} <b>{{botname}}</b> ({{bot}}) · <a href="{{editurl}}">{{#str}} telegram:change, local_oksigeniamarandu {{/str}}</a></p>
    <p class="mrd-note"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11 V17 M12 7.5 V7.6"/></svg><span>{{privacy}}</span></p>
    <h2>{{#str}} telegram:test, local_oksigeniamarandu {{/str}}</h2>
    {{^joined}}
    <p class="mrd-lead">{{#str}} telegram:test:join, local_oksigeniamarandu {{/str}}</p>
    <div class="mrd-cols">
        <div class="mrd-actions">
            <a class="btn mrd-btn mrd-primary" href="{{joinurl}}" target="_blank" rel="noopener">{{#str}} telegram:open, local_oksigeniamarandu {{/str}}</a>
            <a class="btn mrd-btn mrd-second" href="{{action}}">{{#str}} telegram:test:done, local_oksigeniamarandu {{/str}}</a>
        </div>
        <figure class="mrd-tgqr">{{{qr}}}<figcaption>{{#str}} telegram:qr, local_oksigeniamarandu {{/str}}</figcaption></figure>
    </div>
    {{/joined}}
    {{#joined}}
    <p class="mrd-lead">{{#str}} telegram:test:joined, local_oksigeniamarandu {{/str}}</p>
    <form method="post" action="{{action}}" class="mrd-actions">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="test">
        <button type="submit" class="btn mrd-btn mrd-primary">{{#str}} telegram:test:send, local_oksigeniamarandu {{/str}}</button>
        {{#sent}}<span class="mrd-hint">{{sent}}</span>{{/sent}}
    </form>
    {{#error}}<p class="mrd-err">{{error}}</p>{{/error}}
    {{/joined}}
    {{/editing}}
    <h3 class="mrd-group">{{#str}} telegram:track, local_oksigeniamarandu {{/str}}</h3>
    <ol class="mrd-track">
        {{#track}}
            <li class="{{#done}}done{{/done}}{{#now}}now{{/now}}"><i>{{^done}}{{num}}{{/done}}</i><span>{{label}}</span></li>
        {{/track}}
    </ol>
</div>
