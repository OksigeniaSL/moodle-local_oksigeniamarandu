                {{/previews.0}}
            </details>
            {{/cards}}
        </div>
        {{/canconfig}}
        {{/channel}}
    </section>
</div>
{{#js}}
(function() {
    var root = document.querySelector('.local-oksigeniamarandu-channel');
    if (!root) {
        return;
    }
    // What waits for a review: its card larger at a touch.
    root.addEventListener('click', function(e) {
        var button = e.target.closest('.mrd-thumb');
        if (!button) {
            return;
        }
        var image = button.querySelector('img');
        var open = button.getAttribute('aria-expanded') !== 'true';
        if (open && image.dataset.full) {
            image.dataset.small = image.dataset.small || image.src;
            image.src = image.dataset.full;
        } else if (image.dataset.small) {
            image.src = image.dataset.small;
        }
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    // The place from the device, where the browser can give it.
    var reveal = function() {
        if (navigator.geolocation && window.isSecureContext) {
            root.querySelectorAll('.mrd-here').forEach(function(here) {
                here.hidden = false;
            });
        }
    };
    reveal();
    // Each card of the settings saves itself without JavaScript, as a form; with it, the page stays where it is and only
    // the card comes back, as the server draws it after saving. A plain send if anything goes wrong.
    var busy = false;
    var timer = null;
    var plain = function(form, submitter) {
        if (submitter && submitter.name) {
            var field = document.createElement('input');
            field.type = 'hidden';
            field.name = submitter.name;
            field.value = submitter.value;
            form.appendChild(field);
        }
        form.submit();
    };
    var send = function(form, submitter) {
        clearTimeout(timer);
        var part = form.closest('[data-part]');
        if (busy || !part || !window.fetch || !window.DOMParser) {
            plain(form, submitter);
            return;
        }
        busy = true;
        var data = new FormData(form);
        if (submitter && submitter.name) {
            data.append(submitter.name, submitter.value);
        }
        var focus = document.activeElement && part.contains(document.activeElement) ? document.activeElement : null;
        var name = focus ? focus.getAttribute('name') : null;
        var kind = focus ? focus.className : '';
        part.setAttribute('aria-busy', 'true');
        fetch(form.getAttribute('action'), {method: 'POST', body: data, credentials: 'same-origin'}).then(function(response) {
            if (!response.ok) {
                throw new Error(response.status);
            }
            return response.text();
        }).then(function(html) {
            var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById(part.id);
            if (!fresh) {
                throw new Error('missing');
            }
            part.replaceWith(fresh);
            // The colour of the cards also changes their small ones in «What goes to the channel».
            if (part.id === 'mrd-cards') {
                var kinds = new DOMParser().parseFromString(html, 'text/html').getElementById('mrd-what');
                var old = document.getElementById('mrd-what');
                if (kinds && old) {
                    old.replaceWith(kinds);
                }
            }
            reveal();
            busy = false;
            if (name) {
                var again = Array.prototype.filter.call(fresh.querySelectorAll('[name="' + name + '"]'), function(el) {
                    return el.className === kind && !el.disabled;
                })[0] || fresh.querySelector('[name="' + name + '"]:not([disabled])');
                if (again) {
                    again.focus();
                }
            }
        }).catch(function() {
            busy = false;
            plain(form, submitter);
        });
    };
    var last = null;
    root.addEventListener('click', function(e) {
        last = e.target.closest('button[type="submit"]');
    });
    root.addEventListener('submit', function(e) {
        var form = e.target;
        if (!form.closest('[data-part]')) {
            return;
        }
        e.preventDefault();
        send(form, e.submitter || last);
        last = null;
    });
    // An hour, a number or a colour written in its place saves itself a moment after the last change.
    var soon = function(e) {
        if (e.target.matches('[data-solo]')) {
            clearTimeout(timer);
            var form = e.target.form;
            timer = setTimeout(function() {
                send(form, null);
            }, 1200);
        }
    };
    root.addEventListener('input', soon);
    root.addEventListener('change', soon);
    root.addEventListener('click', function(e) {
        var button = e.target.closest('[data-here]');
        if (!button) {
            return;
        }
        var form = button.form;
        navigator.geolocation.getCurrentPosition(function(position) {
            form.querySelector('[data-lat]').value = position.coords.latitude.toFixed(5);
            form.querySelector('[data-lon]').value = position.coords.longitude.toFixed(5);
            send(form, null);
        }, function() {
            form.querySelector('[data-herefailed]').hidden = false;
        }, {timeout: 15000});
    });
})();
{{/js}}
