{{!
    @template local_oksigeniamarandu/panel_links

    The links of the panel and the list, in the header of the page: one row of pills with their drawing.

    Context variables required for this template:
    * links - Each with url, label, count (optional) and art (the context of local_oksigeniamarandu/art).

    Example context (json):
    {
        "links": [{"url": "#", "label": "Numbers", "count": 227, "art": {"size": 22, "numbers": true} }]
    }
}}
<nav class="local-oksigeniamarandu-links" aria-label="{{#str}} pluginname, local_oksigeniamarandu {{/str}}">
    {{#links}}
        <a class="btn" href="{{url}}">{{#art}}{{> local_oksigeniamarandu/art }}{{/art}}{{label}}{{#count}} <small>{{count}}</small>{{/count}}</a>
    {{/links}}
</nav>
