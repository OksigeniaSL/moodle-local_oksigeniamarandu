{{!
    @template local_oksigeniamarandu/wizard_where

    A sketch of the page of Meta where the details of the app are, not a screenshot, so that it does not age with
    every change there. Beside the fields on a wide screen, folded before them on a narrow one.

    Example context (json):
    {}
}}
<svg class="mrd-meta" viewBox="0 0 450 270" role="img" aria-label="{{#str}} wizard:where, local_oksigeniamarandu {{/str}}">
    <rect class="w-top" x="0" y="0" width="450" height="28"/>
    <text class="w-text" x="12" y="18" font-size="11" font-weight="700">Meta for Developers</text>
    <rect class="w-side" x="0" y="28" width="140" height="242"/>
    <text class="w-text" x="12" y="56" font-size="10.5" font-weight="700">WhatsApp</text>
    <rect class="w-item" x="6" y="66" width="128" height="24" rx="5"/>
    <text class="w-itemtext" x="13" y="82" font-size="9.5" font-weight="700">{{#str}} wizard:meta:apisetup, local_oksigeniamarandu {{/str}}</text>
    <text class="w-ink" x="154" y="52" font-size="14" font-weight="700">{{#str}} wizard:meta:apisetup, local_oksigeniamarandu {{/str}}</text>
    <text class="w-text" x="154" y="76" font-size="10">{{#str}} wizard:meta:temptoken, local_oksigeniamarandu {{/str}}</text>
    <rect class="w-box" x="154" y="82" width="280" height="24" rx="5" stroke-width="1.5" stroke-dasharray="4 3"/>
    <text class="w-faint" x="162" y="98" font-size="10.5">EAAG…</text>
    <line class="w-redline" x1="158" y1="94" x2="300" y2="94" stroke-width="1.5"/>
    <text class="w-redtext" x="154" y="120" font-size="9.5" font-weight="700">{{#str}} wizard:where:temporary, local_oksigeniamarandu {{/str}}</text>
    <rect class="w-k1" x="150" y="136" width="290" height="40" rx="6" fill="none" stroke-width="2.5"/>
    <text class="w-text" x="158" y="152" font-size="10">{{#str}} wizard:meta:phonenumberid, local_oksigeniamarandu {{/str}}</text>
    <text class="w-ink" x="158" y="168" font-size="11">1110000000…</text>
    <rect class="w-k2" x="150" y="186" width="290" height="40" rx="6" fill="none" stroke-width="2.5"/>
    <text class="w-text" x="158" y="202" font-size="10">{{#str}} wizard:meta:wabaid, local_oksigeniamarandu {{/str}}</text>
