{{!
    @template local_oksigeniamarandu/limits

    The quiet hours and the limits, for every channel, on a page of their own: the sentences of the last step of the
    wizard of WhatsApp.

    Context variables required for this template:
    * lead, saved - What it is for, and the line after saving.
    * form - The context of local_oksigeniamarandu/limits_form.

    Example context (json):
    {
        "lead": "So that nothing arrives at eleven at night.", "saved": "",
        "form": {"formurl": "#", "sesskey": "abc", "submit": "Save", "money": false, "capmonth": "10", "capemail": "",
            "capemailerror": "", "capfamily": 3, "quietfrom": "20:00", "quietto": "08:00", "days": [], "urgent": [],
            "hasurgent": false}
    }
}}
<div class="local-oksigeniamarandu-wizard local-oksigeniamarandu-limits">
    <section>
        <p class="mrd-lead">{{lead}}</p>
        {{#saved}}<p class="mrd-saved" role="status">{{saved}}</p>{{/saved}}
        {{#form}}{{> local_oksigeniamarandu/limits_form }}{{/form}}
    </section>
</div>
