{{!
    @template local_oksigeniamarandu/channel_stepper

    A number of the page of the channel, written in its place, with one less and one more; 0 is without a limit.

    Context variables required for this template:
    * name, value, most - The setting, its number and the largest it may be.
    * unit - What it counts.
    * less, noless, more, nomore, nocap - One less and one more, whether there is none, and whether it is 0.
    * action - Optional, where its buttons go (the card they come back to), from the context around it.

    Example context (json):
    {
        "name": "postperday", "value": 3, "most": 50, "unit": "a day, at most", "less": 2, "noless": false, "more": 4,
        "nomore": false, "nocap": false
    }
}}
<span class="mrd-paso"><span class="mrd-placa"><input type="number" name="{{name}}" value="{{value}}" min="0" max="{{most}}" aria-label="{{unit}}" data-solo><button type="submit" class="mrd-menos" name="{{name}}" value="{{less}}" aria-label="{{#str}} channel:less, local_oksigeniamarandu, {{less}} {{/str}}"{{#noless}} disabled{{/noless}}{{#action}} formaction="{{action}}"{{/action}}>−</button><button type="submit" class="mrd-mas" name="{{name}}" value="{{more}}" aria-label="{{#str}} channel:more, local_oksigeniamarandu, {{more}} {{/str}}"{{#nomore}} disabled{{/nomore}}{{#action}} formaction="{{action}}"{{/action}}>+</button></span><span class="mrd-paso-t">{{unit}}{{#nocap}}: <b>{{#str}} channel:day:nocap, local_oksigeniamarandu {{/str}}</b>{{/nocap}}</span></span>
