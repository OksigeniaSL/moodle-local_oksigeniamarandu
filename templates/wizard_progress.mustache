{{!
    @template local_oksigeniamarandu/wizard_progress

    The progress of the set-up wizard, in the header of the page: a bar of one part per step and their names; only the
    steps already done are links.

    Context variables required for this template:
    * steps - Each with label, done, now and url.
    * stepinfo - "Step 1 of 2 · Account".

    Example context (json):
    {
        "steps": [
            {"label": "Account", "done": true, "now": false, "url": "https://example.com/local/oksigeniamarandu/wizard.php?step=account"},
            {"label": "Test", "done": false, "now": true, "url": ""}
        ],
        "stepinfo": "Step 2 of 2 · Test"
    }
}}
<div class="local-oksigeniamarandu-progress" aria-label="{{#str}} wizard:progress, local_oksigeniamarandu {{/str}}">
    <div class="mrd-bar">{{#steps}}<i class="{{#done}}done{{/done}}{{#now}}now{{/now}}"></i>{{/steps}}</div>
    <div class="mrd-labels">
        {{#steps}}
            {{#done}}<a href="{{url}}">{{label}}</a>{{/done}}
            {{^done}}{{#now}}<span class="now">{{stepinfo}}</span>{{/now}}{{^now}}<span>{{label}}</span>{{/now}}{{/done}}
        {{/steps}}
    </div>
</div>
