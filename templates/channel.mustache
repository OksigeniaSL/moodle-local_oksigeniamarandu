{{!
    @template local_oksigeniamarandu/channel

    The channel of Telegram of the site: how to take one, or the one it has, with what goes there by itself and what is
    reviewed first, the hours of review and of the channel, and the posts waiting or gone out.

    Context variables required for this template:
    * lead, saved, error - What it is for, the line after saving and an error.
    * canconfig - Whether the user runs the site: the settings are for them; whoever only reviews sees what is waiting.
    * nobot, boturl - Without a bot, the link to its page.
    * formurl, sesskey - Where the forms go.
    * connect - Without a channel: botname and candidate (id, title, username), the channel Telegram said the bot can post in.
    * channel - With a channel: title, username, url, problem, members, growth, reviewers, noreviewers, kinds (name, desc,
      field, choices with value, id, label, on), reviewfrom, reviewto, reviewdays and postfrom, postto, postdays (group,
      value, label, name, on), and the posts review, ready, published and failed (id, title, kind, when, clicks, error,
      urgent), and empty; the calendar: calendarical, calendarsite, calendarlink, calendarkeywords, classdays, weekhour and
      evehour; the weather warnings: weatherfeed, weatherareas, weatherlevels (value, id, label, on) and weatherstatus;
      the place: latitude and longitude; the sky: skytle, skydefault, skysummary (lines) and skynoplace; the links: utm,
      utmsource, utmmedium, shortener and hassignature; the cards: cardcolor, cardorg, cardorgdefault, cardanimated,
      ffmpeg, cardstatus, previewurl and previews (alt, src).

    Example context (json):
    {
        "lead": "What everyone may read.", "saved": "", "error": "", "canconfig": true, "nobot": false, "boturl": "#",
        "formurl": "#",
        "sesskey": "abc", "connect": {"botname": "@example_bot", "candidate": {"id": "-100123", "title": "Example school",
        "username": "@exampleschool"} }
    }
}}
<div class="local-oksigeniamarandu-wizard local-oksigeniamarandu-channel">
    <section>
        <p class="mrd-lead">{{lead}}</p>
        {{#saved}}<p class="mrd-saved" role="status">{{saved}}</p>{{/saved}}
        {{#error}}<p class="mrd-err" role="alert">{{error}}</p>{{/error}}

        {{#canconfig}}
        {{#nobot}}
        <p>{{#str}} channel:nobot, local_oksigeniamarandu {{/str}}</p>
        <div class="mrd-actions"><a class="btn mrd-btn mrd-primary" href="{{boturl}}">{{#str}} channel:gobot, local_oksigeniamarandu {{/str}}</a></div>
        {{/nobot}}
        {{/canconfig}}
        {{^canconfig}}{{^channel}}<p class="mrd-warn">{{#str}} channel:notconnected, local_oksigeniamarandu {{/str}}</p>{{/channel}}{{/canconfig}}

        {{#connect}}
        <h3>{{#str}} channel:connect, local_oksigeniamarandu {{/str}}</h3>
        <ol class="mrd-steps">
            <li>{{#str}} channel:connect:step1, local_oksigeniamarandu, {{botname}} {{/str}}</li>
            <li>{{#str}} channel:connect:step2, local_oksigeniamarandu {{/str}}</li>
        </ol>
        {{#candidate}}
        <form method="post" action="{{formurl}}" class="mrd-found">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="connect">
            <input type="hidden" name="chat" value="{{id}}">
            <p><strong>{{title}}</strong> {{#username}}<span class="mrd-muted">{{.}}</span>{{/username}}</p>
            <button type="submit" class="mrd-btn mrd-primary">{{#str}} channel:use, local_oksigeniamarandu {{/str}}</button>
        </form>
        {{/candidate}}
        <form method="post" action="{{formurl}}" class="mrd-byname">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="connect">
            <label for="mrd-chat">{{#str}} channel:byname, local_oksigeniamarandu {{/str}}</label>
            <span class="mrd-row"><input id="mrd-chat" type="text" name="chat" placeholder="@" autocomplete="off">
            <button type="submit" class="mrd-btn mrd-second">{{#str}} channel:connectbutton, local_oksigeniamarandu {{/str}}</button></span>
        </form>
        {{/connect}}

        {{#channel}}
        <div class="mrd-head">
            <div>
                <h3>{{title}} {{#url}}<a href="{{url}}" target="_blank" rel="noopener">{{username}}</a>{{/url}}</h3>
                <p class="mrd-muted">{{members}}{{#growth}} · {{.}}{{/growth}}</p>
            </div>
            {{#canconfig}}
            <form method="post" action="{{formurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="disconnect">
                <button type="submit" class="mrd-btn mrd-second">{{#str}} channel:disconnect, local_oksigeniamarandu {{/str}}</button>
            </form>
            {{/canconfig}}
        </div>
        {{#problem}}<p class="mrd-err" role="alert">{{.}}</p>{{/problem}}
        <p class="{{#noreviewers}}mrd-warn{{/noreviewers}}{{^noreviewers}}mrd-muted{{/noreviewers}}">{{reviewers}}</p>

        {{#review.0}}
        <h3 id="mrd-review">{{#str}} channel:waiting, local_oksigeniamarandu {{/str}}</h3>
        <ul class="mrd-posts">
            {{#review}}
            <li><span class="mrd-post"><strong>{{title}}</strong> <small>{{kind}}{{#urgent}} · {{#str}} channel:urgent, local_oksigeniamarandu {{/str}}{{/urgent}}</small></span>
                <form method="post" action="{{formurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="post" value="{{id}}">
                    <button type="submit" name="action" value="publish" class="mrd-btn mrd-primary">{{#str}} channel:review:publish, local_oksigeniamarandu {{/str}}</button>
                    <button type="submit" name="action" value="skip" class="mrd-btn mrd-second">{{#str}} channel:review:skip, local_oksigeniamarandu {{/str}}</button>
                </form>
            </li>
            {{/review}}
        </ul>
        {{/review.0}}
        {{#ready.0}}
        <h3>{{#str}} channel:next, local_oksigeniamarandu {{/str}}</h3>
        <ul class="mrd-posts">{{#ready}}<li><span class="mrd-post"><strong>{{title}}</strong> <small>{{kind}} · {{when}}</small></span></li>{{/ready}}</ul>
        {{/ready.0}}
        {{#published.0}}
        <h3>{{#str}} channel:published, local_oksigeniamarandu {{/str}}</h3>
        <ul class="mrd-posts">{{#published}}<li><span class="mrd-post"><strong>{{title}}</strong> <small>{{kind}} · {{when}}{{#clicks}} · {{.}}{{/clicks}}</small></span></li>{{/published}}</ul>
        {{/published.0}}
        {{#failed.0}}
        <h3 id="mrd-failed">{{#str}} channel:failed, local_oksigeniamarandu {{/str}}</h3>
        <ul class="mrd-posts">{{#failed}}<li><span class="mrd-post"><strong>{{title}}</strong> <small>{{kind}} · {{error}}</small></span></li>{{/failed}}</ul>
        {{/failed.0}}
        {{#empty}}<p class="mrd-muted">{{#str}} channel:empty, local_oksigeniamarandu {{/str}}</p>{{/empty}}

        {{#canconfig}}
        <form method="post" action="{{formurl}}" class="mrd-sentences">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="save">
            <h3>{{#str}} channel:what, local_oksigeniamarandu {{/str}}</h3>
            <ul class="mrd-kinds">
                {{#kinds}}
                <li><span class="mrd-kind"><strong>{{name}}</strong>{{#desc}} <small>{{.}}</small>{{/desc}}</span>
                    <span class="mrd-choices" role="radiogroup" aria-label="{{name}}">{{#choices}}<input type="radio" class="mrd-choice" id="{{id}}" name="policy[{{field}}]" value="{{value}}" {{#on}}checked{{/on}}><label for="{{id}}">{{label}}</label>{{/choices}}</span>
                </li>
                {{/kinds}}
            </ul>
            <h3>{{#str}} channel:hours, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sentence">{{#str}} channel:hours:review1, local_oksigeniamarandu {{/str}}
                <input type="time" name="reviewfrom" value="{{reviewfrom}}" aria-label="{{#str}} wizard:limits:from, local_oksigeniamarandu {{/str}}">
                {{#str}} wizard:limits:quiet2, local_oksigeniamarandu {{/str}}
                <input type="time" name="reviewto" value="{{reviewto}}" aria-label="{{#str}} wizard:limits:to, local_oksigeniamarandu {{/str}}">
                <span class="mrd-days">{{#reviewdays}}<input type="checkbox" id="mrd-{{group}}-{{value}}" name="{{group}}days[{{value}}]" value="1" {{#on}}checked{{/on}}><label for="mrd-{{group}}-{{value}}" title="{{name}}"><span aria-hidden="true">{{label}}</span><span class="sr-only visually-hidden">{{name}}</span></label>{{/reviewdays}}</span></p>
            <p class="mrd-sub">{{#str}} channel:hours:review2, local_oksigeniamarandu {{/str}}</p>
            <p class="mrd-sentence">{{#str}} channel:hours:post1, local_oksigeniamarandu {{/str}}
                <input type="time" name="postfrom" value="{{postfrom}}" aria-label="{{#str}} wizard:limits:from, local_oksigeniamarandu {{/str}}">
                {{#str}} wizard:limits:quiet2, local_oksigeniamarandu {{/str}}
                <input type="time" name="postto" value="{{postto}}" aria-label="{{#str}} wizard:limits:to, local_oksigeniamarandu {{/str}}">
                <span class="mrd-days">{{#postdays}}<input type="checkbox" id="mrd-{{group}}-{{value}}" name="{{group}}days[{{value}}]" value="1" {{#on}}checked{{/on}}><label for="mrd-{{group}}-{{value}}" title="{{name}}"><span aria-hidden="true">{{label}}</span><span class="sr-only visually-hidden">{{name}}</span></label>{{/postdays}}</span></p>
            <p class="mrd-sub">{{#str}} channel:hours:post2, local_oksigeniamarandu {{/str}}</p>

            <h3>{{#str}} channel:calendar, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:calendar:desc, local_oksigeniamarandu {{/str}}</p>
            <div class="mrd-fields">
                <label for="mrd-ical">{{#str}} channel:calendar:ical, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-ical" type="url" name="calendarical" value="{{calendarical}}" placeholder="https://" autocomplete="off">
                <span class="mrd-check"><input type="checkbox" id="mrd-calsite" name="calendarsite" value="1" {{#calendarsite}}checked{{/calendarsite}}><label for="mrd-calsite">{{#str}} channel:calendar:site, local_oksigeniamarandu {{/str}}</label></span>
                <label for="mrd-callink">{{#str}} channel:calendar:link, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-callink" type="url" name="calendarlink" value="{{calendarlink}}" placeholder="https://" autocomplete="off">
                <label for="mrd-keywords">{{#str}} channel:calendar:keywords, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-keywords" type="text" name="calendarkeywords" value="{{calendarkeywords}}" aria-describedby="mrd-keywords-desc">
                <small id="mrd-keywords-desc">{{#str}} channel:calendar:keywords_desc, local_oksigeniamarandu {{/str}}</small>
            </div>
            <p class="mrd-sentence">{{#str}} channel:calendar:classdays, local_oksigeniamarandu {{/str}}
                <span class="mrd-days">{{#classdays}}<input type="checkbox" id="mrd-{{group}}-{{value}}" name="{{group}}days[{{value}}]" value="1" {{#on}}checked{{/on}}><label for="mrd-{{group}}-{{value}}" title="{{name}}"><span aria-hidden="true">{{label}}</span><span class="sr-only visually-hidden">{{name}}</span></label>{{/classdays}}</span></p>
            <p class="mrd-sentence">{{#str}} channel:calendar:weekhour, local_oksigeniamarandu {{/str}}
                <input type="time" name="weekhour" value="{{weekhour}}" aria-label="{{#str}} channel:calendar:weekhour, local_oksigeniamarandu {{/str}}"></p>
            <p class="mrd-sentence">{{#str}} channel:calendar:evehour, local_oksigeniamarandu {{/str}}
                <input type="time" name="evehour" value="{{evehour}}" aria-label="{{#str}} channel:calendar:evehour, local_oksigeniamarandu {{/str}}"></p>

            <h3>{{#str}} channel:weather, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:weather:desc, local_oksigeniamarandu {{/str}}{{#weatherstatus}} <strong>{{.}}</strong>{{/weatherstatus}}</p>
            <div class="mrd-fields">
                <label for="mrd-weatherfeed">{{#str}} channel:weather:feed, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-weatherfeed" type="url" name="weatherfeed" value="{{weatherfeed}}" placeholder="https://" autocomplete="off">
                <label for="mrd-weatherareas">{{#str}} channel:weather:areas, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-weatherareas" type="text" name="weatherareas" value="{{weatherareas}}" autocomplete="off" aria-describedby="mrd-weatherareas-desc">
                <small id="mrd-weatherareas-desc">{{#str}} channel:weather:areas_desc, local_oksigeniamarandu {{/str}}</small>
            </div>
            <p class="mrd-sentence">{{#str}} channel:weather:severity, local_oksigeniamarandu {{/str}}
                <span class="mrd-choices" role="radiogroup" aria-label="{{#str}} channel:weather:severity, local_oksigeniamarandu {{/str}}">{{#weatherlevels}}<input type="radio" class="mrd-choice" id="{{id}}" name="weatherseverity" value="{{value}}" {{#on}}checked{{/on}}><label for="{{id}}">{{label}}</label>{{/weatherlevels}}</span></p>

            <h3>{{#str}} channel:place, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:place:desc, local_oksigeniamarandu {{/str}}</p>
            <div class="mrd-fields">
                <label for="mrd-latitude">{{#str}} channel:place:latitude, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-latitude" type="text" inputmode="decimal" name="latitude" value="{{latitude}}" autocomplete="off">
                <label for="mrd-longitude">{{#str}} channel:place:longitude, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-longitude" type="text" inputmode="decimal" name="longitude" value="{{longitude}}" autocomplete="off">
            </div>

            <h3>{{#str}} channel:sky, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:sky:desc, local_oksigeniamarandu {{/str}}</p>
            {{#skynoplace}}<p class="mrd-warn">{{#str}} channel:sky:noplace, local_oksigeniamarandu {{/str}}</p>{{/skynoplace}}
            {{#skysummary.0}}<ul class="mrd-sky">{{#skysummary}}<li>{{.}}</li>{{/skysummary}}</ul>{{/skysummary.0}}
            <div class="mrd-fields">
                <label for="mrd-skytle">{{#str}} channel:sky:tle, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-skytle" type="url" name="skytle" value="{{skytle}}" placeholder="{{skydefault}}" autocomplete="off" aria-describedby="mrd-skytle-desc">
                <small id="mrd-skytle-desc">{{#str}} channel:sky:tle_desc, local_oksigeniamarandu {{/str}}</small>
            </div>

            <h3>{{#str}} channel:links, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:links:desc, local_oksigeniamarandu {{/str}}</p>
            <div class="mrd-fields">
                <span class="mrd-check"><input type="checkbox" id="mrd-utm" name="utm" value="1" {{#utm}}checked{{/utm}}><label for="mrd-utm">{{#str}} channel:links:utm, local_oksigeniamarandu {{/str}}</label></span>
                <label for="mrd-utmsource">utm_source</label>
                <input id="mrd-utmsource" type="text" name="utmsource" value="{{utmsource}}" autocomplete="off">
                <label for="mrd-utmmedium">utm_medium</label>
                <input id="mrd-utmmedium" type="text" name="utmmedium" value="{{utmmedium}}" autocomplete="off">
                <label for="mrd-shortener">{{#str}} channel:links:shortener, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-shortener" type="url" name="shortener" value="{{shortener}}" placeholder="https://" autocomplete="off">
                <label for="mrd-signature">{{#str}} channel:links:signature, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-signature" type="password" name="shortenersignature" value="" autocomplete="new-password" {{#hassignature}}placeholder="{{#str}} channel:links:signatureset, local_oksigeniamarandu {{/str}}"{{/hassignature}}>
            </div>
            <h3 id="mrd-cards">{{#str}} channel:cards, local_oksigeniamarandu {{/str}}</h3>
            <p class="mrd-sub">{{#str}} channel:cards:desc, local_oksigeniamarandu {{/str}} {{cardstatus}}</p>
            <div class="mrd-fields">
                <label for="mrd-cardcolor">{{#str}} channel:cards:color, local_oksigeniamarandu {{/str}}</label>
                <span class="mrd-check"><input id="mrd-cardcolor" type="color" name="cardcolor" value="{{cardcolor}}">
                <input type="checkbox" id="mrd-cardcolordefault" name="cardcolordefault" value="1"><label for="mrd-cardcolordefault">{{#str}} channel:cards:colordefault, local_oksigeniamarandu {{/str}}</label></span>
                <label for="mrd-cardorg">{{#str}} channel:cards:org, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-cardorg" type="text" name="cardorg" value="{{cardorg}}" placeholder="{{cardorgdefault}}">
                <span class="mrd-check"><input type="checkbox" id="mrd-cardanimated" name="cardanimated" value="1" {{#cardanimated}}checked{{/cardanimated}}><label for="mrd-cardanimated">{{#str}} channel:cards:animated, local_oksigeniamarandu {{/str}}</label></span>
                <label for="mrd-ffmpeg">{{#str}} channel:cards:ffmpeg, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-ffmpeg" type="text" name="ffmpeg" value="{{ffmpeg}}" placeholder="/usr/bin/ffmpeg" autocomplete="off">
            </div>
            <div class="mrd-actions"><button type="submit" class="mrd-btn mrd-primary">{{#str}} savechanges {{/str}}</button>
                <a class="btn mrd-btn mrd-second" href="{{previewurl}}">{{#str}} channel:cards:preview, local_oksigeniamarandu {{/str}}</a></div>
        </form>
        {{#previews.0}}
        <p class="mrd-muted">{{#str}} channel:cards:sample, local_oksigeniamarandu {{/str}}</p>
        <div class="mrd-previews">{{#previews}}<img src="{{src}}" alt="{{alt}}" width="640" height="360">{{/previews}}</div>
        {{/previews.0}}
        {{/canconfig}}
        {{/channel}}
    </section>
</div>
