{{!
    @template local_oksigeniamarandu/proposals

    «Sugerencias», the page of whoever receives them: three tabs (to attend, at Oksigenia, closed) with their figures;
    in each, what does not work first, then the ideas, each one a card (local_oksigeniamarandu/proposal_card).

    Context variables required for this template:
    * lead - What the page is.
    * tabs - Each: label, count, url, current.
    * groups - Each: kind (idea or fallo), isissue, label, count, cards (as proposal_card takes them).
    * none - Nothing in this tab, in words; empty if there is something.

    Example context (json):
    {
        "lead": "Lo que proponen y lo que no les funciona a las personas del sitio.",
        "tabs": [{"label": "Por atender", "count": 1, "url": "#", "current": true},
            {"label": "En Oksigenia", "count": 0, "url": "#", "current": false},
            {"label": "Cerradas", "count": 0, "url": "#", "current": false}],
        "groups": [{"kind": "idea", "isissue": false, "label": "Ideas", "count": 1, "cards": [{"id": 3, "kind": "idea",
            "text": "Ver dos semanas a la vez.", "who": "Ana Pérez", "when": "ayer a las 17:40", "where": "Oksigenia Meals",
            "url": "", "extra": "", "image": "", "portrait": false, "formurl": "#", "sesskey": "abc",
            "open": {"release": "0.116.2", "donelabel": "Hecho, en la versión", "whyhint": "Se guarda al pulsar Intro.",
            "remote": ""}, "seal": false}]}],
        "none": ""
    }
}}
<div class="sg-recibe">
    <p class="sg-lead">{{lead}}</p>
    <nav class="sg-pestanas" aria-label="{{#str}} proposals:title, local_oksigeniamarandu {{/str}}">
        {{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}} <b>{{count}}</b></a>{{/tabs}}
    </nav>
    {{#none}}<p class="sg-vacio">{{none}}</p>{{/none}}
    {{#groups}}
    <h2 class="sg-grupo"><span class="sg-tag sg-t-{{kind}}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">{{#isissue}}<path d="M12.5 3.5h8v8l-9 9-8-8z"/><circle cx="16.8" cy="7.2" r="1.3"/><path d="M8 11.5l2 2M10.5 9l2 2"/>{{/isissue}}{{^isissue}}<path d="M4.5 4.5h15v9.5l-5.5 5.5h-9.5z"/><path d="M19.5 14h-5.5v5.5"/><path d="M8 9h7.5M8 12.5h4"/>{{/isissue}}</svg>{{label}}</span><small>{{count}}</small></h2>
    <div class="sg-lista">
        {{#cards}}{{> local_oksigeniamarandu/proposal_card }}{{/cards}}
    </div>
    {{/groups}}
</div>
