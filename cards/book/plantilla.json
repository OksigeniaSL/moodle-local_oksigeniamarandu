{
  "id": "book",
  "label": {
    "es": "Libro recomendado",
    "en": "Recommended book"
  },
  "version": 1,
  "size": [
    1280,
    720
  ],
  "files": {
    "background": "fondo.png",
    "accent": "acento.png",
    "background_video": "fondo.mp4",
    "accent_video": "acento.mp4"
  },
  "fonts": {
    "regular": "Onest-Regular.ttf",
    "medium": "Onest-Medium.ttf",
    "semibold": "Onest-SemiBold.ttf",
    "bold": "Onest-Bold.ttf",
    "extrabold": "Onest-ExtraBold.ttf"
  },
  "fonts_note": "Onest (SIL OFL 1.1), static cuts with a legacy kern table so GD kerns too.",
  "metrics": {
    "ascent": 0.93,
    "descent": 0.24
  },
  "palette": {
    "paper": "#f4eee3",
    "ink": "#24211d",
    "ink_soft": "#5a5650"
  },
  "accent": {
    "source": "Brand colour of the site's Moodle theme; any colour works.",
    "rules": [
      {
        "type": "text_on_accent",
        "min_contrast": 4.5,
        "candidates": [
          "#ffffff",
          "#24211d"
        ]
      }
    ],
    "fit": "If a rule fails, mix the brand colour with white or with black in 1 % steps and keep the first that passes every rule (try white then black at each step). Use that colour for the whole accent layer of the card.",
    "on_accent": "For colour 'on_accent', use the candidate with the higher contrast on the fitted accent."
  },
  "video": {
    "duration": 6.0,
    "fps": 25,
    "frames": 150,
    "loop": "seamless: the frame after the last one is the first one",
    "accent_video": "alpha as luma, full range (yuvj420p): read it with format=gray before alphamerge",
    "compose": {
      "loops": 2,
      "exit": {
        "effect": "fade",
        "duration": 0.5
      },
      "note": "Telegram plays an animation in a loop. The card lasts two loops of the background; the texts come in at the start and fade out in the last 0.5 s, so the restart is clean. D = loops * duration."
    }
  },
  "zones": [
