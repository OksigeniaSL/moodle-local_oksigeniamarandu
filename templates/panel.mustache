{{!
    @template local_oksigeniamarandu/panel

    The panel: the state first, with its scene and each channel; on a brand-new site the way to the first notice and what
    will appear here; then today, the month day by day with what WhatsApp costs, what failed, who joined or left, and
    each notice by channel. From the mock-up of the house.

    Context variables required for this template:
    * hero - tone, scene (SVG), ribbon, party (confetti pieces), title, text, chips, actions, hasactions and choices.
    * path, pathlabel - The four steps of a brand-new site, or null.
    * ghosts - What will appear here, on a brand-new site, or null.
    * grid - today, month, failed, nofailed, allgood, people and notices, once something has gone out; or null.

    Example context (json):
    {
        "hero": {"tone": "ok", "scene": "", "ribbon": "", "party": [], "title": "Everything running", "text": "Notices go out.",
            "chips": [{"icon": "", "name": "Telegram", "status": "running", "class": ""}], "actions": [], "hasactions": false,
            "choices": []},
        "path": null, "pathlabel": "To start", "ghosts": null, "grid": null
    }
}}
<div class="local-oksigeniamarandu-dash local-oksigeniamarandu-board">
    {{#hero}}
    <section class="mrd-hero {{tone}}" aria-live="polite">
        <svg class="mrd-trail" viewBox="0 0 800 200" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M150 196 C330 198 520 192 640 156 S770 70 812 4" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="0.5 12" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg>
        <div class="mrd-hero-art">{{{scene}}}{{#party.0}}<span class="mrd-confetti" aria-hidden="true">{{#party}}<i style="{{style}}"></i>{{/party}}</span>{{/party.0}}</div>
        <div>
            {{#ribbon}}<p class="mrd-ribbon">{{ribbon}}</p>{{/ribbon}}
            <h2>{{title}}</h2>
            <p>{{text}}</p>
            {{#chips.0}}<ul class="mrd-chips" aria-label="{{#str}} panel:channels, local_oksigeniamarandu {{/str}}">{{#chips}}<li>{{{icon}}}{{name}}<b class="st {{class}}">{{status}}</b></li>{{/chips}}</ul>{{/chips.0}}
        </div>
        {{#hasactions}}<div class="mrd-hero-act">{{#actions}}<a class="btn mrd-btn {{kind}}" href="{{url}}">{{label}}</a>{{/actions}}</div>{{/hasactions}}
        {{#choices.0}}<div class="mrd-choices">{{#choices}}<a class="btn mrd-choice" href="{{url}}">{{{icon}}}<b>{{name}}</b><span>{{text}}</span><em>{{cta}}</em></a>{{/choices}}</div>{{/choices.0}}
    </section>
    {{/hero}}

    {{#path.0}}
    <ol class="mrd-path" aria-label="{{pathlabel}}">
        {{#path}}<li class="{{class}}"{{#now}} aria-current="step"{{/now}}><span class="num">{{num}}</span><b>{{title}}</b><small>{{small}}</small>{{{icon}}}</li>{{/path}}
    </ol>
    {{/path.0}}

    {{#ghosts}}
    <h2 class="mrd-preview">{{#str}} panel:preview, local_oksigeniamarandu {{/str}}</h2>
    <div class="mrd-ghosts">
        <section class="mrd-ghost"><h3>{{#str}} panel:today, local_oksigeniamarandu {{/str}}</h3><div class="rows" aria-hidden="true"><i class="w92"></i><i class="w74"></i><i class="w55"></i></div><p>{{today}}</p></section>
        <section class="mrd-ghost"><h3>{{#str}} panel:month, local_oksigeniamarandu {{/str}}</h3><div class="viz" aria-hidden="true">{{#cols}}<i style="height:{{height}}%"></i>{{/cols}}</div><p>{{month}}</p></section>
        <section class="mrd-ghost"><h3>{{#str}} panel:bynotice, local_oksigeniamarandu {{/str}}</h3><div class="rows" aria-hidden="true"><i class="w80"></i><i class="w62"></i><i class="w35"></i></div><p>{{#str}} panel:ghost:bynotice, local_oksigeniamarandu {{/str}}</p></section>
        {{#real}}<section class="mrd-ghost real"><h3>{{#str}} panel:people, local_oksigeniamarandu {{/str}}</h3><p class="big"><b>{{count}}</b> {{label}}</p><span class="tag">{{#str}} panel:ghost:firsttag, local_oksigeniamarandu {{/str}}</span><p class="mrd-ink">{{text}}</p></section>{{/real}}
        {{^real}}<section class="mrd-ghost"><h3>{{#str}} panel:people, local_oksigeniamarandu {{/str}}</h3><div class="who">{{{peopleicon}}}</div><p>{{people}}</p>{{#join.0}}<ul class="mrd-join">{{#join}}<li>{{{icon}}}<span>{{text}}</span></li>{{/join}}</ul>{{/join.0}}</section>{{/real}}
    </div>
    {{/ghosts}}

    {{#grid}}
    <div class="mrd-grid">
        {{#today}}
        <section class="mrd-box">
            <h3>{{#str}} panel:today, local_oksigeniamarandu {{/str}} <span>{{until}}</span></h3>
            <div class="mrd-headline">
                <p class="fig"><b class="mrd-big">{{sent}}</b><span>{{sentlabel}}</span></p>
                {{#failed}}<a class="btn mrd-pill bad" href="#mrd-failed">{{failed}}</a>{{/failed}}{{^failed}}<span class="mrd-pill ok">{{nofailed}}</span>{{/failed}}
            </div>
            <ul class="mrd-chan">
                {{#rows}}
                <li><span class="mrd-chico {{channel}}">{{{icon}}}</span><div><p class="name"><b>{{name}}</b>{{#count}}<b>{{count}}</b>{{/count}}</p>
                    {{#whatsapp}}
                    <div class="mrd-funnel" role="img" aria-label="{{label}}"><i class="d" style="width:{{delivered}}%"></i><i class="r" style="width:{{read}}%"></i></div>
                    <ul class="mrd-keys"><li><i class="mrd-sw wa"></i><b>{{nread}}</b> {{#str}} panel:today:read, local_oksigeniamarandu {{/str}}</li><li><i class="mrd-sw wa-mid"></i><b>{{ndelivered}}</b> {{#str}} panel:today:delivered, local_oksigeniamarandu {{/str}}</li><li><i class="mrd-sw wa-track"></i>{{#str}} panel:today:of, local_oksigeniamarandu {{/str}} <b>{{nsent}}</b></li></ul>
                    {{/whatsapp}}
                    {{^whatsapp}}<p class="note">{{note}}</p>{{/whatsapp}}
                </div></li>
                {{/rows}}
            </ul>
            <div class="mrd-wait">
                <p class="mrd-label">{{#str}} panel:waiting, local_oksigeniamarandu {{/str}}</p>
                {{#waits.0}}<ul>{{#waits}}<li>{{{icon}}}<b>{{count}}</b><span>{{label}}</span><span>{{when}}</span></li>{{/waits}}</ul>{{/waits.0}}
                {{#nowait}}<p class="none">{{#str}} panel:waiting:none, local_oksigeniamarandu {{/str}}</p>{{/nowait}}
            </div>
            {{#last}}
            <div class="mrd-last">
                <p class="mrd-label">{{#str}} panel:last, local_oksigeniamarandu {{/str}}</p>
                <p class="item">{{{icon}}}<span><b>{{name}}</b> · {{when}}, {{#str}} panel:last:by, local_oksigeniamarandu, {{channel}} {{/str}}</span></p>
            </div>
            {{/last}}
        </section>
        {{/today}}

        {{#month}}
        <section class="mrd-box">
            <h3>{{#str}} panel:month, local_oksigeniamarandu {{/str}} <span>{{name}}</span></h3>
            <div class="mrd-headline">
                <p class="fig"><b class="mrd-big">{{total}}</b><span>{{totallabel}}</span></p>
                {{#haslegend}}<ul class="mrd-legend">{{#legend}}<li><i class="mrd-sw {{channel}}"></i>{{{icon}}}{{name}} <b>{{count}}</b></li>{{/legend}}</ul>{{/haslegend}}
            </div>
            <div class="mrd-days" tabindex="0" role="img" aria-label="{{label}}">
                <div class="mrd-cols">{{#cols}}{{#future}}<span class="mrd-col future"></span>{{/future}}{{^future}}<span class="mrd-col" data-tip="{{tip}}">{{#segments}}<i class="{{channel}}" style="height:calc({{height}}% - {{gap}}px);--n:{{n}}"></i>{{/segments}}{{#peak}}<b class="peak" style="bottom:calc({{bottom}}% + .1em)">{{n}}</b>{{/peak}}</span>{{/future}}{{/cols}}</div>
                <div class="mrd-axis" aria-hidden="true">{{#axis}}<span{{#today}} class="today"{{/today}}>{{label}}</span>{{/axis}}</div>
                <div class="mrd-tip" hidden></div>
            </div>
            <details class="mrd-tableview">
                <summary>{{#str}} panel:month:table, local_oksigeniamarandu {{/str}}</summary>
                <div class="mrd-tablewrap"><table class="table-reboot"><thead><tr><th>{{#str}} panel:month:dayhead, local_oksigeniamarandu {{/str}}</th>{{#heads}}<th>{{name}}</th>{{/heads}}{{#totalhead}}<th>{{#str}} panel:month:totalhead, local_oksigeniamarandu {{/str}}</th>{{/totalhead}}</tr></thead>
                <tbody>{{#table}}<tr><td>{{day}}</td>{{#cells}}<td>{{v}}</td>{{/cells}}{{#total}}<td>{{total}}</td>{{/total}}</tr>{{/table}}</tbody></table></div>
            </details>
            {{#cost}}
            <div class="mrd-cost">
                <p class="mrd-label">{{#str}} panel:cost, local_oksigeniamarandu {{/str}} <span class="mrd-light">· {{#str}} panel:cost:rough, local_oksigeniamarandu {{/str}}</span></p>
                <p class="money"><b>{{spent}}</b><span>{{cap}}</span></p>
                <div class="mrd-meter {{class}}" role="img" aria-label="{{label}}">{{#likely}}<i class="likely" style="width:{{likely}}%"></i>{{/likely}}<i style="width:{{pct}}%"></i></div>
                {{#scale.0}}<div class="mrd-scale">{{#scale}}<span>{{.}}</span>{{/scale}}</div>{{/scale.0}}
                <p class="mrd-fine">{{fine}}</p>
            </div>
            {{/cost}}
            {{#tgonly}}<p class="mrd-free">{{{tgicon}}}<span><b>{{#str}} panel:free, local_oksigeniamarandu {{/str}}</b> {{#str}} panel:free_desc, local_oksigeniamarandu {{/str}}</span></p>{{/tgonly}}
            {{#tgtoo}}<p class="mrd-fine">{{{tgiconsmall}}} {{#str}} panel:free_tg, local_oksigeniamarandu {{/str}}</p>{{/tgtoo}}
        </section>
        {{/month}}

        <section class="mrd-box" id="mrd-failed">
            <h3>{{#str}} panel:failed, local_oksigeniamarandu {{/str}} <span>{{#str}} panel:failed:last, local_oksigeniamarandu {{/str}}</span></h3>
            {{#failed.0}}<ul class="mrd-failed">{{#failed}}<li><span class="when">{{time}}</span>{{{icon}}}<div><b>{{name}}</b> · <span class="num">{{phone}}</span><span class="why">{{why}}</span></div></li>{{/failed}}</ul>{{/failed.0}}
            {{#nofailed}}<p class="mrd-allgood">{{{allgood}}}<span>{{#str}} panel:failed:none, local_oksigeniamarandu {{/str}}</span></p>{{/nofailed}}
        </section>

        {{#people}}
        <section class="mrd-box">
            <h3>{{#str}} panel:people, local_oksigeniamarandu {{/str}}</h3>
            <div class="mrd-people">
                <div class="ok"><b>{{active}}</b><span>{{activelabel}}</span></div>
                <div class="{{pendingclass}}"><b>{{pending}}</b><span>{{pendinglabel}}</span></div>
                <div><b>{{optedout}}</b><span>{{#str}} panel:people:optedout, local_oksigeniamarandu {{/str}}</span></div>
            </div>
            {{#hassplit}}
            <div class="mrd-split">
                <div class="bar" role="img" aria-label="{{splitlabel}}">{{#split}}<i class="{{channel}}" style="flex:{{count}}"></i>{{/split}}</div>
                <ul class="mrd-legend">{{#split}}<li><i class="mrd-sw {{channel}}"></i>{{{icon}}}{{name}} <b>{{count}}</b></li>{{/split}}</ul>
            </div>
            {{/hassplit}}
            {{#moves.0}}<ul class="mrd-moves">{{#moves}}<li><span class="when">{{time}}</span><span class="mrd-tag {{#in}}in{{/in}}{{^in}}out{{/in}}">{{tag}}</span>{{{icon}}}<span>{{who}} <small>· {{how}}</small></span></li>{{/moves}}</ul>{{/moves.0}}
            {{#nomoves}}<p class="mrd-fine">{{#str}} panel:people:none, local_oksigeniamarandu {{/str}}</p>{{/nomoves}}
            <a class="btn mrd-btn second small" href="{{listurl}}">{{#str}} panel:people:list, local_oksigeniamarandu {{/str}}</a>
        </section>
        {{/people}}

        {{#notices}}
        <section class="mrd-box mrd-wide">
            <h3>{{#str}} panel:bynotice, local_oksigeniamarandu {{/str}} <span>{{total}}</span></h3>
            {{#legend.0}}<ul class="mrd-legend mrd-legendgap">{{#legend}}<li><i class="mrd-sw {{channel}}"></i>{{{icon}}}{{name}}</li>{{/legend}}</ul>{{/legend.0}}
            {{#hasitems}}
            <ul class="mrd-notices">
                {{#items}}
                <li><span class="mrd-nicon">{{{icon}}}</span><span class="t"><b>{{name}}</b><br><small>{{small}}</small></span><b class="v">{{count}}</b>
                    {{#bars.0}}<div class="bar" aria-hidden="true">{{#bars}}<i class="{{channel}}" style="width:{{width}}%"></i>{{/bars}}</div>{{/bars.0}}
                    {{#empty}}<div class="bar empty" aria-hidden="true"></div>{{/empty}}</li>
                {{/items}}
            </ul>
            {{/hasitems}}
            {{#showoff}}<p class="mrd-off"><span>{{offlabel}}</span>{{#hasitems}}{{#offs}}<span class="mrd-offchip">{{{icon}}}{{name}}</span>{{/offs}}{{/hasitems}}
                <a class="mrd-btn link" href="{{noticesurl}}">{{offcta}}</a></p>{{/showoff}}
        </section>
        {{/notices}}
    </div>
    {{/grid}}
</div>
