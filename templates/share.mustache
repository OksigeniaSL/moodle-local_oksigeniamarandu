{{!
    @template local_oksigeniamarandu/share

    To the channel: the photo of a piece of work of a class, its title, its group and a few words, sent to the review of
    the channel of Telegram of the site.

    Context variables required for this template:
    * lead, sent, error, closed - What it is for, the line after sending, an error, and why it cannot be sent now.
    * formurl, courseurl, sesskey - Where the form goes and the way back to the course.
    * maxmb, limits - The largest photo, in megabytes, and the longest title, group and text.
    * title, group, text - What was written.

    Example context (json):
    {
        "lead": "A piece of work of the class for the channel.", "sent": "", "error": "", "closed": "", "formurl": "#",
        "courseurl": "#", "sesskey": "abc", "maxmb": 15, "limits": {"title": 80, "group": 80, "text": 400},
        "title": "", "group": "Pottery workshop", "text": ""
    }
}}
<div class="local-oksigeniamarandu-wizard local-oksigeniamarandu-channel local-oksigeniamarandu-share">
    <section>
        <p class="mrd-lead">{{lead}}</p>
        {{#sent}}<p class="mrd-saved" role="status">{{sent}}</p>{{/sent}}
        {{#error}}<p class="mrd-err" role="alert">{{error}}</p>{{/error}}
        {{#closed}}<p class="mrd-warn">{{closed}}</p>{{/closed}}
        {{^closed}}
        <form method="post" action="{{formurl}}" enctype="multipart/form-data">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="mrd-fields">
                <label for="mrd-photo">{{#str}} classwork:photo, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-photo" type="file" name="photo" accept="image/jpeg,image/png,image/webp" required aria-describedby="mrd-photo-desc">
                <small id="mrd-photo-desc">{{#str}} classwork:photo_desc, local_oksigeniamarandu, {{maxmb}} {{/str}}</small>
                <label for="mrd-title">{{#str}} classwork:worktitle, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-title" type="text" name="title" value="{{title}}" maxlength="{{limits.title}}" required autocomplete="off">
                <label for="mrd-group">{{#str}} classwork:group, local_oksigeniamarandu {{/str}}</label>
                <input id="mrd-group" type="text" name="group" value="{{group}}" maxlength="{{limits.group}}" autocomplete="off" aria-describedby="mrd-group-desc">
                <small id="mrd-group-desc">{{#str}} classwork:group_desc, local_oksigeniamarandu {{/str}}</small>
                <label for="mrd-text">{{#str}} classwork:text, local_oksigeniamarandu {{/str}}</label>
                <textarea id="mrd-text" name="text" rows="3" maxlength="{{limits.text}}">{{text}}</textarea>
            </div>
            <p class="mrd-check"><input type="checkbox" id="mrd-confirm" name="confirm" value="1" required><label for="mrd-confirm">{{#str}} classwork:confirm, local_oksigeniamarandu {{/str}}</label></p>
            <div class="mrd-actions">
                <button type="submit" class="mrd-btn mrd-primary">{{#str}} classwork:send, local_oksigeniamarandu {{/str}}</button>
                <a class="btn mrd-btn mrd-second" href="{{courseurl}}">{{#str}} classwork:back, local_oksigeniamarandu {{/str}}</a>
            </div>
        </form>
        {{/closed}}
    </section>
</div>
