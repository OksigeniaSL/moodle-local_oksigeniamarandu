{{!
    @template local_oksigeniamarandu/telegram_progress

    The three steps of the page of Telegram, in the header beside the title: done in green, now in blue, the rest in
    grey. On a phone, only the step of now, with its number.

    Context variables required for this template:
    * steps - Each with label, pos (its number, for a phone), done, now and shown.

    Example context (json):
    {
        "steps": [
            {"label": "Connect the bot", "pos": "Step 1 of 3 · ", "done": true, "now": false, "shown": false},
            {"label": "Join from your phone", "pos": "Step 2 of 3 · ", "done": false, "now": true, "shown": false},
            {"label": "Try it", "pos": "Step 3 of 3 · ", "done": false, "now": false, "shown": false}
        ]
    }
}}
<div class="local-oksigeniamarandu-tgsteps" role="group" aria-label="{{#str}} telegram:track, local_oksigeniamarandu {{/str}}">
    <div class="mrd-bar" aria-hidden="true">{{#steps}}<i class="{{#done}}done{{/done}}{{#now}}now{{/now}}"></i>{{/steps}}</div>
    <ol class="mrd-labels">
        {{#steps}}
            <li class="{{#done}}done{{/done}}{{#now}}now{{/now}}{{#shown}} shown{{/shown}}"{{#now}} aria-current="step"{{/now}}><span class="mrd-pos">{{pos}}</span>{{label}}</li>
        {{/steps}}
    </ol>
</div>
