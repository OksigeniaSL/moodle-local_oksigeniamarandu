            {{#cards}}
            <details class="mrd-plegada" id="mrd-cards" data-part{{#open}} open{{/open}}>
                <summary><span class="mrd-cara mrd-cara-color" style="--c: {{colour}}"></span>
                    <span class="mrd-plegada-t"><b>{{#str}} channel:cards, local_oksigeniamarandu {{/str}}</b><span>{{line}}</span></span>
                    {{#saved}}<span class="mrd-sello" role="status">{{#str}} channel:stamp, local_oksigeniamarandu {{/str}}</span>{{/saved}}<span class="mrd-cambiar" aria-hidden="true">{{#str}} channel:change, local_oksigeniamarandu {{/str}}</span></summary>
                <form method="post" action="{{formurl}}" class="mrd-dentro">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="save">
                    <input type="hidden" name="part" value="cards">
                    <input type="hidden" name="cardanimated" value="{{#animated}}1{{/animated}}{{^animated}}0{{/animated}}">
                    <button type="submit" class="mrd-default" tabindex="-1" aria-hidden="true"></button>
                    <p class="mrd-explica">{{#str}} channel:cards:desc, local_oksigeniamarandu {{/str}}</p>
                    <div class="mrd-tarjeta">
                        {{#sample}}<img class="mrd-muestra" src="{{.}}" alt="{{#str}} channel:cards:sampleone, local_oksigeniamarandu {{/str}}" width="640" height="360">{{/sample}}
                        <div class="mrd-tarjeta-gestos">
                            <h4 id="mrd-cards-colour">{{#str}} channel:cards:color, local_oksigeniamarandu {{/str}}</h4>
                            <div class="mrd-colores" role="group" aria-labelledby="mrd-cards-colour">
                                <button type="submit" class="mrd-color" name="cardcolordefault" value="1" aria-pressed="{{#own}}false{{/own}}{{^own}}true{{/own}}"><span class="mrd-color-m" style="--c: {{theme}}" aria-hidden="true"></span>{{#str}} channel:cards:colordefault, local_oksigeniamarandu {{/str}}</button>
                                <label class="mrd-color{{#own}} mrd-color-propio{{/own}}"><input type="color" name="cardcolor" value="{{colour}}" data-solo><span>{{#str}} channel:cards:own, local_oksigeniamarandu {{/str}}</span></label>
                            </div>
                            <button type="submit" class="mrd-llave" name="cardanimated" value="{{#animated}}0{{/animated}}{{^animated}}1{{/animated}}" aria-pressed="{{#animated}}true{{/animated}}{{^animated}}false{{/animated}}"><span class="mrd-llave-i" aria-hidden="true"></span>{{#str}} channel:cards:animated, local_oksigeniamarandu {{/str}}</button>
                            <p class="mrd-estado">{{status}}</p>
                            <a class="mrd-link" href="{{previewurl}}">{{#str}} channel:cards:preview, local_oksigeniamarandu {{/str}}</a>
                        </div>
                    </div>
                    <div class="mrd-dorso">
                        <div class="mrd-campos">
                            <label class="mrd-campo"><span>{{#str}} channel:cards:org, local_oksigeniamarandu {{/str}}</span>
                                <input type="text" name="cardorg" value="{{org}}" placeholder="{{orgdefault}}"></label>
                            <label class="mrd-campo"><span>{{#str}} channel:cards:ffmpeg, local_oksigeniamarandu {{/str}}</span>
